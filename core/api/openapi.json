            "type": "string"
          },
          "v": {
            "type": "integer"
          }
        },
        "required": [
          "time",
          "stream",
          "type",
          "v",
          "data"
        ],
        "type": "object"
      },
      "Models": {
        "properties": {
          "embeddingModel": {
            "type": [
              "string",
              "null"
            ]
          },
          "engine": {
            "type": "string"
          },
          "idleUnloadMinutes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "llamaServerPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "modelsDir": {
            "type": [
              "string",
              "null"
            ]
          },
          "options": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ModelOptions"
            },
            "type": "object"
          }
        },
        "required": [
          "llamaServerPath",
          "modelsDir",
          "embeddingModel",
          "idleUnloadMinutes",
          "options",
          "engine"
