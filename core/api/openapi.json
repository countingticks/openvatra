          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "type": "object"
      },
      "Event": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ConfigChangedEvent"
          },
          {
            "$ref": "#/components/schemas/ModelStateEvent"
          },
          {
            "$ref": "#/components/schemas/DownloadProgressEvent"
          }
