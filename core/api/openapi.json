            "type": "string"
          },
          "modelsDir": {
            "type": "string"
          }
        },
        "required": [
          "llamaServerPath",
          "modelsDir"
        ],
        "type": "object"
      },
      "Report": {
        "properties": {
          "error": {
            "type": "string"
          },
          "gpu": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GPU"
              },
