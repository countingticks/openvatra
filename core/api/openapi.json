  "info": {
    "title": "OpenVatra core",
    "version": "0.1.0",
    "x-api-level": 1
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/catalog": {
      "get": {
        "operationId": "getCatalog",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/View"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error."
          }
        },
        "summary": "The models to download, judged against this PC",
        "tags": [
          "catalog"
        ],
        "x-scope": "ui"
      }
    },
    "/api/catalog/{id}/folder": {
      "get": {
        "operationId": "getCatalogFolder",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogFolder"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error. Codes: unknown_model, no_models_folder, internal."
          }
        },
        "summary": "The folder a catalog model lives in",
        "tags": [
          "catalog"
        ],
        "x-scope": "shell"
      }
    },
    "/api/chats": {
      "get": {
        "operationId": "listChats",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Chat"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error. Codes: chat_unavailable, internal."
          }
        },
        "summary": "List the chats, newest first",
        "tags": [
          "chats"
        ],
        "x-scope": "ui"
      },
      "post": {
        "operationId": "createChat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChat"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chat"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error. Codes: invalid_request, bad_request, chat_unavailable, internal."
          }
        },
        "summary": "Start a chat",
        "tags": [
          "chats"
        ],
        "x-scope": "ui"
      }
    },
    "/api/chats/{id}": {
      "delete": {
        "operationId": "deleteChat",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error. Codes: chat_unavailable, chat_not_found, internal."
          }
        },
        "summary": "Delete a chat",
        "tags": [
          "chats"
        ],
        "x-scope": "ui"
      },
      "get": {
        "operationId": "getChat",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatWithMessages"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error. Codes: chat_unavailable, chat_not_found, internal."
          }
        },
        "summary": "One chat with its messages",
        "tags": [
          "chats"
        ],
        "x-scope": "ui"
      },
      "patch": {
        "operationId": "updateChat",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "model": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "webSearch": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chat"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error. Codes: invalid_request, chat_unavailable, chat_not_found, bad_request, internal."
          }
        },
        "summary": "Change a chat's title, model or web search",
        "tags": [
          "chats"
        ],
        "x-scope": "ui"
      }
    },
    "/api/chats/{id}/export": {
      "get": {
        "operationId": "exportChat",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/markdown": {}
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error. Codes: chat_unavailable, chat_not_found, internal."
          }
        },
        "summary": "A chat as Markdown",
        "tags": [
          "chats"
        ],
        "x-scope": "ui"
      }
    },
    "/api/chats/{id}/messages": {
      "post": {
        "operationId": "sendMessage",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error. Codes: chat_unavailable, chat_not_found, bad_request, no_streaming, internal."
          }
        },
        "summary": "Send a message and stream the reply",
        "tags": [
          "chats"
        ],
        "x-scope": "ui"
      }
    },
    "/api/chats/{id}/regenerate": {
      "post": {
        "operationId": "regenerate",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error. Codes: chat_unavailable, chat_not_found, bad_request, no_streaming, internal."
          }
        },
        "summary": "Answer the last message again, streamed",
        "tags": [
          "chats"
        ],
        "x-scope": "ui"
      }
    },
    "/api/config": {
      "get": {
        "operationId": "getConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigAll"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
