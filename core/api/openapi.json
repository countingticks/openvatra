          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "TokenRequest": {
        "properties": {
          "scope": {
            "description": "only \"ui\" can be issued",
            "type": "string"
          }
        },
        "required": [
          "scope"
        ],
        "type": "object"
      },
      "VersionBody": {
        "properties": {
          "api": {
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
