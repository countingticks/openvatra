                "type": "null"
              }
            ]
          },
          "ramBytes": {
            "type": "integer"
          }
        },
        "required": [
          "gpu",
          "ramBytes"
        ],
        "type": "object"
      },
      "SectionEntry": {
        "properties": {
          "effective": {},
          "rev": {
            "type": "integer"
          },
          "value": {}
