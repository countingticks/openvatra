        "type": "object"
      },
      "DownloadProgressEvent": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/DownloadsBody"
          },
          "seq": {
            "description": "durable events only",
            "type": "integer"
          },
          "stream": {
            "type": "string"
          },
          "time": {
            "type": "integer"
          },
          "type": {
            "enum": [
              "download.progress"
            ],
            "type": "string"
          },
          "v": {
            "type": "integer"
          }
        },
        "required": [
          "time",
          "stream",
          "type",
          "v",
          "data"
        ],
        "type": "object"
      },
      "DownloadsBody": {
        "properties": {
