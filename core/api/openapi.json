          }
        },
        "required": [
          "name",
          "sizeBytes",
          "sha256"
        ],
        "type": "object"
      },
      "GPU": {
        "properties": {
          "freeBytes": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "totalBytes": {
            "type": "integer"
          },
          "vendor": {
            "type": "string"
          }
        },
        "required": [
