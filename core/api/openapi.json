          },
          "log": {
            "type": "string"
          },
          "reset": {
            "type": "boolean"
          }
        },
        "required": [
          "log",
          "head",
          "reset"
        ],
        "type": "object"
      },
      "Item": {
        "properties": {
          "baseUrl": {
            "type": "string"
          },
          "diskShortBytes": {
            "type": "integer"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/File"
            },
            "type": "array"
          },
          "fit": {
            "enum": [
              "fits",
              "slower",
              "tooBig"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "installed": {
            "type": "boolean"
          },
          "licence": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "needsGB": {
            "type": "integer"
          },
          "rank": {
            "type": "integer"
          },
          "repo": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "summary",
          "tags",
          "licence",
          "repo",
          "revision",
          "files",
          "needsGB",
          "rank",
          "fit",
          "installed",
          "diskShortBytes"
        ],
        "type": "object"
      },
      "Message": {
        "properties": {
          "chatId": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "reasoning": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "stats": {},
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "chatId",
          "role",
          "content",
          "reasoning",
          "status",
          "error",
          "model",
          "stats",
          "createdAt"
        ],
        "type": "object"
      },
      "Model": {
        "properties": {
          "busy": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "chat",
              "embedding",
              "unreadable"
            ],
            "type": "string"
          },
          "projector": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer"
          },
          "state": {
            "enum": [
              "stopped",
              "loading",
              "ready",
              "error"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "state",
          "busy",
          "sizeBytes",
          "kind"
        ],
        "type": "object"
      },
      "ModelOptions": {
        "properties": {
          "args": {
            "type": "string"
          }
        },
        "required": [
          "args"
        ],
        "type": "object"
      },
      "ModelStateEvent": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/StateBody"
          },
          "seq": {
