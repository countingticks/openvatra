{
  "permissions": {
    "deny": [
      "Read(./package-lock.json)",
      "Read(./core/go.sum)",
      "Read(./vendor/**)",
      "Read(./private/brand/**/frames.json)",
      "Read(./out/**)",
      "Read(./dist/**)",
      "Read(./release/**)",
      "Read(./coverage/**)",
      "Read(./test-results/**)",
      "Read(./playwright-report/**)",
      "Bash(npm test*)",
      "Bash(npm run test:e2e*)",
      "Bash(npx playwright test*)",
      "PowerShell(npm test*)",
      "PowerShell(npm run test:e2e*)",
      "PowerShell(npx playwright test*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
