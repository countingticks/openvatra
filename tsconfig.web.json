{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/app/**/*",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "tests/setup.ts",
    "tests/unit/**/*"
  ],
  "exclude": ["tests/unit/main/**/*"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@app": ["src/app/index.ts"],
      "@app/*": ["src/app/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
