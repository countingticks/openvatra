# Normalize line endings: text files are stored with LF in the repository
* text=auto eol=lf

# Windows scripts need CRLF to run correctly
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.gif binary
*.woff2 binary
*.gguf binary

# Captured program output, kept byte for byte (CRLF included)
core/internal/hw/testdata/** -text
